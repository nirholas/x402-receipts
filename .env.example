# ── Where the money goes ─────────────────────────────────────────────────────
# Both rails ship pre-filled with the x402 Suite's public receive addresses, so
# the service runs out of the box. Change them to YOUR addresses to get paid.

# EVM (Base / Base Sepolia) USDC receive address
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# Solana USDC receive address
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# ── Networks ─────────────────────────────────────────────────────────────────
# Used both for accepting payment AND as the default network when resolving a
# transaction id whose network isn't given explicitly.
# EVM rail: base-sepolia (default, testnet) or base (mainnet).
NETWORK=base-sepolia
# Solana rail: mainnet-beta (default) or devnet.
SOLANA_NETWORK=mainnet-beta

# ── Facilitators (verify + settle) ───────────────────────────────────────────
#   x402.org           → base-sepolia, solana-devnet   (free, testnet)
#   facilitator.payai  → base, base-sepolia, solana    (free, no API key)
FACILITATOR_URL=https://x402.org/facilitator
SOLANA_FACILITATOR_URL=https://facilitator.payai.network

# ── Chain resolvers ──────────────────────────────────────────────────────────
# Receipt lookups read the chain through PUBLIC, KEYLESS RPC by default, so
# nothing here is required. Both public endpoints are rate-limited — point these
# at a dedicated provider (Alchemy, Helius, QuickNode…) before relying on it.
# BASE_RPC_URL=https://mainnet.base.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Ledger ───────────────────────────────────────────────────────────────────
# Every resolved receipt is cached here, which is also what /export exports.
LEDGER_FILE=data/receipts.json

# ── Auth ─────────────────────────────────────────────────────────────────────
# Guards POST /annotate/:tx. CHANGE THIS before exposing the service.
ADMIN_KEY=dev-admin-key

# ── Signing ──────────────────────────────────────────────────────────────────
# Secret for the HMAC-SHA256 signatures on receipts and exports. A dev default
# is used when unset — ALWAYS set your own, or exported books are forgeable.
# SIGNING_SECRET=change-me

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4033
# Public origin used in the 402 `resource` field when behind a proxy.
# PUBLIC_BASE_URL=https://receipts.example.com

# ── Client example (examples/agent-client.ts) ────────────────────────────────
# Funded base-sepolia wallet the example agent pays with.
# PRIVATE_KEY=0x...
# BASE_URL=http://localhost:4033
